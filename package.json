{
  "name": "english-4-you",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "npx tsx --env-file=.env.local scripts/seed-admin.ts",
    "db:generate:prod": "cross-env DB_ENV=production drizzle-kit generate",
    "db:migrate:prod": "cross-env DB_ENV=production drizzle-kit migrate",
    "db:push:prod": "cross-env DB_ENV=production drizzle-kit push",
    "db:studio:prod": "cross-env DB_ENV=production drizzle-kit studio",
    "storage:deploy": "npx -y firebase-tools@latest deploy --only storage --project INSERIR_NOME_AQUI",
    "firestore:deploy": "npx -y firebase-tools@latest deploy --only firestore --project INSERIR_NOME_AQUI",
    "database:deploy": "npx -y firebase-tools@latest deploy --only database --project INSERIR_NOME_AQUI",
    "storage:deploy:prod": "npx -y firebase-tools@latest deploy --only storage --project INSERIR_NOME_AQUI_PROD",
    "firestore:deploy:prod": "npx -y firebase-tools@latest deploy --only firestore --project INSERIR_NOME_AQUI_PROD",
    "database:deploy:prod": "npx -y firebase-tools@latest deploy --only database --project INSERIR_NOME_AQUI_PROD",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.13.0",
    "@hookform/resolvers": "^5.7.1",
